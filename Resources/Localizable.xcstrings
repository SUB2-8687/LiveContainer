      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App returned from its main function with code %d."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
