          }
        }
      }
    },
    "lc.shared.moveBackFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer was unable to move the data of shared app back because LiveContainer cannot access app group. Please check JITLess diagnose page in LiveContainer settings for more information."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer가 앱 그룹에 접근할 수 없어 공유 앱의 데이터를 되돌려 이동하지 못했습니다. 자세한 내용은 LiveContainer 설정의 JITLess 진단 페이지를 확인해주세요."
          }
        }
      }
    },
    "lc.appInfo.corrupted" : {
      "extractionState" : "manual",
