{
  "sourceLanguage" : "en",
  "strings" : {
    "lc.launch.jitlessRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JITLess mode is required since iOS 26. Please set it up in settings. \nPlease go to LiveContainer settings -> tap \"Import Certificate from SideStore\" / \"Import Certificate\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26부터는 JITLess 모드가 필요합니다. 설정에서 JITLess 모드를 설정해주세요.\nLiveContainer 설정 -> \"SideStore에서 인증서 가져오기\" / \"인증서 가져오기\"를 눌러주세요."
          }
        }
      }
    },
    "lc.launch.jitNotEnabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT was not enabled. If you want to use LiveContainer without JIT, setup JITLess mode in settings."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT가 활성화되지 않았습니다. JIT 없이 LiveContainer를 사용하려면 설정에서 JITLess 모드를 설정해주세요."
          }
        }
      }
    },
    "lc.launch.appBundleNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App bundle not found! Unable to read LCAppInfo.plist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 번들을 찾을 수 없습니다! LCAppInfo.plist를 읽을 수 없습니다."
          }
        }
      }
    },
    "lc.launch.appNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App not found"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 찾을 수 없습니다."
          }
        }
      }
    },
    "lc.launch.containerNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container not found!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨테이너를 찾을 수 없습니다!"
          }
        }
      }
    },
    "lc.launch.bookmarkTimeout" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bookmark resolution timed out. Is the data storage offline?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북마크 확인 시간이 초과되었습니다. 데이터 저장소가 오프라인 상태인가요?"
          }
        }
      }
    },
    "lc.launch.bookmarkFailed %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bookmark resolution failed or unable to access the container. You might need to readd the data storage. %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북마크 확인에 실패했거나 컨테이너에 접근할 수 없습니다. 데이터 저장소를 다시 추가해야 할 수 있습니다. %@"
          }
        }
      }
    },
    "lc.launch.executableNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App's executable path not found. Please try force re-signing or reinstalling this app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 실행 파일 경로를 찾을 수 없습니다. 강제 재서명하거나 앱을 다시 설치해보세요."
          }
        }
      }
    },
    "lc.launch.jitRequired32" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT is required to run 32-bit apps."
